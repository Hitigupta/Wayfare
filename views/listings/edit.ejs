<% layout("/layouts/boilerplate.ejs") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <h3 style="text-align: center;">Edit the details</h3>
            <form action="/listings/<%= listing._id %>?_method=put" method="post" data-bs-validate novalidate>
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input placeholder="<%= listing.title %>" name="list[title]" class="form-control">
            </div>
            <br>
            <div>
                <label for="desc" class="form-label">Description</label>
                <input placeholder="<%= listing.description %>" name="list[description]" class="form-control">
            </div>
            <br>
            <div>
                <label for="image-name" class="form-label">Image name</label>
                <input placeholder="<%= listing.image.filename %>" name="list[image][filename]" class="form-control">
            </div>
            <br>
            <div>
                <label for="image-url" class="form-label">Image url</label>
                <input placeholder="<%= listing.image.url %>" name="list[image][url]" class="form-control">
            </div>
            <br>  
            <div>
                <label for="price" class="form-label">Price</label>
                <input placeholder="<%= listing.price %>" name="list[price]" class="form-control">
            </div> 
            <br>
            <div>
                <label for="country" class="form-label">Country</label>
                <input placeholder="<%= listing.country %>" name="list[country]" class="form-control">
            </div> 
            <br>
            <div>
                <label for="location" class="form-label">Location</label>
                <input placeholder="<%= listing.location %>" name="list[location]" class="form-control">
            </div>
            <br><br>
            <button class="btn btn-dark edit-btn">Update</button>
            </form>
        </div>
    </div>
</body>